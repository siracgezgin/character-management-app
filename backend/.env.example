# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches the credentials in the repository root docker-compose.yml.
# If you change POSTGRES_PORT when starting the container, update it here too.
DATABASE_URL="postgresql://character_app:character_app_password@localhost:5432/character_management?schema=public"

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
PORT=4000

# Comma-separated list of origins allowed to call the GraphQL API.
CORS_ORIGINS="http://localhost:3000"
