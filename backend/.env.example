# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# LOCAL (docker-compose): one connection string is enough.
DATABASE_URL="postgresql://character_app:character_app_password@localhost:5432/character_management?schema=public"

# HOSTED (Supabase): use two. The app runs on the pooled connection, while
# Prisma Migrate and the seeder need a direct one - a transaction pooler cannot
# take the advisory locks migrations rely on.
#
#   DATABASE_URL -> Supabase "Transaction pooler"  (port 6543)
#   DIRECT_URL   -> Supabase "Direct connection"   (port 5432)
#
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
# Ignored on Vercel, which supplies its own port.
PORT=4000

# Comma-separated list of origins allowed to call the GraphQL API.
# In production set this to the deployed frontend URL, e.g.
# CORS_ORIGINS="https://character-management-app-fr.vercel.app"
CORS_ORIGINS="http://localhost:3000"

# Vercel gives every preview deployment a fresh *.vercel.app hostname, which an
# exact-match list cannot cover. Set to "true" to also accept those origins.
CORS_ALLOW_VERCEL_PREVIEWS="false"
